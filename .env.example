# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. NEXT_PUBLIC_* vars are exposed to the browser;
# SUPABASE_SERVICE_ROLE_KEY must never be exposed client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — test mode keys from https://dashboard.stripe.com/test/apikeys.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (local dev) or the
# webhook endpoint's signing secret in the Stripe dashboard (deployed).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
