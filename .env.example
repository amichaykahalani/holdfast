# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. NEXT_PUBLIC_* vars are exposed to the browser;
# SUPABASE_SERVICE_ROLE_KEY must never be exposed client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal — Sandbox app credentials from https://developer.paypal.com/dashboard/applications.
# Payouts must be enabled on the app. PAYPAL_WEBHOOK_ID is assigned when the
# webhook subscription (pointing at /api/webhooks/paypal) is registered —
# https://developer.paypal.com/dashboard/webhooks. PAYPAL_API_BASE defaults
# to the Sandbox base URL if unset; switch to https://api-m.paypal.com for live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=

# Auto-generated secret Vercel Cron sends back as a Bearer token so random
# requests can't trigger the auto-release sweep. Any random string works
# locally; generate one with `openssl rand -hex 32`.
CRON_SECRET=
